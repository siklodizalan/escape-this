        "multicolumn_q9aEBt": {
            "type": "ss-steps-2",
            "blocks": {
                "column_fXtQKF": {
                    "type": "step",
                    "settings": {
                        "hide_number": true,
                        "title": "Bestehendes Erlebnis",
                        "text": "<p><strong>Gemeinsam lachen, knobeln und gewinnen: <\/strong>Schicken Sie Ihr Team auf eine unvergessliche Mission! In unseren regulären Escape Games ist Köpfchen und Zusammenhalt gefragt – denn nur als Einheit lassen sich die kniffligen Aufgaben meistern. Freuen Sie sich auf ein nachhaltiges Teamevent, das Generationen verbindet und den Teamgeist auf ein neues Level hebt.<\/p>",
                        "link_label": "ZUR SPIELAUSWAHL",
                        "link": "shopify:\/\/collections",
                        "card_bg_color": "#1e1e1e",
                        "card_border_color": "#1e1e1e"
                    }
                },
                "column_APRgJ9": {
                    "type": "step",
                    "settings": {
                        "hide_number": true,
                        "title": "Individuelles Erlebnis",
                        "text": "<p><strong>Ihre Idee, unser Know-how – das ultimative Teamevent: <\/strong>Wir erschaffen gemeinsam mit Ihnen ein maßgeschneidertes Outdoor Escape Game, das perfekt auf Ihr Unternehmen zugeschnitten ist. Welches Thema Sie auch bespielen möchten: Toben Sie sich kreativ aus, wir setzen es digital und interaktiv um. Klingt spannend? Dann wenden Sie sich einfach direkt an unseren unten stehenden Kontakt.<\/p>",
                        "link_label": "INDIVIDUELLE ANFRAGE STELLEN",
                        "link": "mailto:business@escape-this.com",
                        "card_bg_color": "#1e1e1e",
                        "card_border_color": "#1e1e1e"
                    }
                }
            },
