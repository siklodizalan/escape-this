{%- liquid
  assign padding_horizontal = section.settings.padding_horizontal
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign border_color = section.settings.border_color
  assign border_thickness = section.settings.border_thickness
  assign margin_top = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign margin_horizontal_mobile = section.settings.margin_horizontal_mobile
  assign margin_horizontal = section.settings.margin_horizontal
  assign background_color = section.settings.background_color
  assign background_gradient = section.settings.background_gradient
  assign full_width = section.settings.full_width
  assign section_radius = section.settings.section_radius

  assign caption_block = section.blocks | where: 'type', 'caption' | first
  assign heading_block = section.blocks | where: 'type', 'heading' | first
  assign text_block = section.blocks | where: 'type', 'text' | first
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign category_blocks = section.blocks | where: 'type', 'category'
  assign faq_item_blocks = section.blocks | where: 'type', 'faq_item'

  assign tab_active_bg = section.settings.tab_active_bg
  assign tab_active_text = section.settings.tab_active_text
  assign tab_inactive_border = section.settings.tab_inactive_border
  assign tab_inactive_text = section.settings.tab_inactive_text
  assign tab_radius = section.settings.tab_radius

  assign feature_icon_bg_color = section.settings.feature_icon_bg_color
  assign feature_icon_color = section.settings.feature_icon_color
  assign feature_text_color = section.settings.feature_text_color

  assign faq_items_gap = section.settings.faq_items_gap
  assign faq_items_gap_mobile = section.settings.faq_items_gap_mobile
  assign faq_item_bg_color = section.settings.faq_item_bg_color
  assign faq_item_radius = section.settings.faq_item_radius
  assign faq_item_padding_horizontal = section.settings.faq_item_padding_horizontal
  assign faq_item_padding_horizontal_mobile = section.settings.faq_item_padding_horizontal_mobile
  assign faq_item_padding_vertical = section.settings.faq_item_padding_vertical
  assign faq_item_padding_vertical_mobile = section.settings.faq_item_padding_vertical_mobile
  assign faq_question_color = section.settings.faq_question_color
  assign faq_question_size = section.settings.faq_question_size
  assign faq_question_size_mobile = section.settings.faq_question_size_mobile
  assign faq_answer_color = section.settings.faq_answer_color
  assign faq_answer_size = section.settings.faq_answer_size
  assign faq_answer_size_mobile = section.settings.faq_answer_size_mobile
  assign faq_answer_padding_top = section.settings.faq_answer_padding_top
  assign faq_icon_color = section.settings.faq_icon_color
  assign faq_icon_size = section.settings.faq_icon_size
-%}

{%- style -%}
  .section-{{ section.id }} {
    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
    margin-left: {{ margin_horizontal_mobile }}rem;
    margin-right: {{ margin_horizontal_mobile }}rem;
    border-radius: {{ section_radius | times: 0.6 | round: 0 }}px;
    overflow: hidden;
  }

  .section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
  }

  .donations-caption-{{ section.id }} {
    margin: 0;
    font-size: 16px;
    color: #f9f544;
    text-transform: uppercase;
    font-weight: 700;
  }

  .donations-heading-{{ section.id }} {
    margin: 0;
    margin-top: 8px;
    font-size: 28px;
    color: #ffffff;
    text-transform: uppercase;
    font-weight: 800;
    word-break: break-word;
  }

  .donations-intro-{{ section.id }} {
    margin: 0;
    margin-top: 20px;
    font-size: 14px;
    line-height: 150%;
    color: #ffffff;
    text-transform: uppercase;
  }

  .donations-features-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 24px;
  }

  .donations-feature-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .donations-feature-icon-{{ section.id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 5px;
    background-color: {{ feature_icon_bg_color }};
  }

  .donations-feature-icon-{{ section.id }} svg {
    width: 16px;
    height: auto;
  }

  .donations-feature-icon-{{ section.id }} svg path {
    fill: {{ feature_icon_color }};
  }

  .donations-feature-text-{{ section.id }} {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: {{ feature_text_color }};
    text-transform: uppercase;
  }

  .donations-tabs-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .donations-tab-{{ section.id }} {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 41px;
    padding: 0 16px;
    border-radius: {{ tab_radius }}px;
    border: 1px solid {{ tab_inactive_border }};
    background-color: transparent;
    color: {{ tab_inactive_text }};
    font-size: 16px;
    font-weight: 800;
    text-transform: uppercase;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .donations-tab-{{ section.id }}.is-active {
    background-color: {{ tab_active_bg }};
    border-color: {{ tab_active_bg }};
    color: {{ tab_active_text }};
  }

  .donations-tab-full-{{ section.id }} {
    display: none;
  }

  @media (max-width: 1023.98px) {
    .donations-tabs-{{ section.id }} {
      flex-wrap: nowrap;
    }

    .donations-tab-{{ section.id }} {
      flex: 0 0 auto;
      width: 56px;
      padding: 0;
    }
  }

  @media (min-width: 1024px) {
    .donations-tab-{{ section.id }} {
      padding: 0 25px;
    }

    .donations-tab-index-{{ section.id }} {
      display: none;
    }

    .donations-tab-full-{{ section.id }} {
      display: inline;
    }
  }

  .donations-panels-{{ section.id }} {
    margin-top: 32px;
    width: calc(100% + {{ padding_horizontal_mobile | times: 2 }}rem);
    margin-left: -{{ padding_horizontal_mobile }}rem;
    margin-right: -{{ padding_horizontal_mobile }}rem;
  }

  .donations-panel-{{ section.id }} {
    display: none;
    flex-direction: column;
    gap: {{ faq_items_gap_mobile }}px;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
  }

  .donations-panel-{{ section.id }}.is-active {
    display: flex;
  }

  .donations-faq-item-{{ section.id }} {
    width: 100%;
    padding: {{ faq_item_padding_vertical_mobile }}px {{ faq_item_padding_horizontal_mobile }}px;
    border-radius: {{ faq_item_radius }}px;
    background-color: {{ faq_item_bg_color | hex_to_rgba: 0.5 }};
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    position: relative;
    transition: all 0.25s ease 0s;
  }

  .donations-faq-item-{{ section.id }}:hover,
  .donations-faq-item-{{ section.id }}.is-active {
    background-color: {{ faq_item_bg_color }};
  }

  .donations-faq-toggle-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    gap: 12px;
  }

  .donations-faq-question-{{ section.id }} {
    margin: 0;
    font-size: {{ faq_question_size_mobile }}px;
    color: {{ faq_question_color }};
    font-weight: 700;
    text-transform: unset;
  }

  .donations-faq-icon-{{ section.id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ faq_icon_size }}px;
    height: {{ faq_icon_size }}px;
    transition: all 0.25s ease 0s;
  }

  .donations-faq-icon-{{ section.id }} svg {
    width: 100%;
    height: 100%;
    transition: all 0.25s ease 0s;
  }

  .donations-faq-icon-{{ section.id }} svg path {
    fill: {{ faq_icon_color }};
  }

  .donations-faq-icon-{{ section.id }}.is-active svg {
    transform: rotate(180deg);
    transition: all 0.25s ease 0s;
  }

  .donations-faq-answer-{{ section.id }} {
    transition: all 0.2s ease-in-out;
    overflow: hidden;
  }

  .donations-faq-answer-{{ section.id }} * {
    margin: 0;
    font-size: {{ faq_answer_size_mobile }}px;
    color: {{ faq_answer_color }};
    text-transform: unset;
  }

  .donations-faq-answer-{{ section.id }} p:not(:first-child) {
    margin-top: 10px;
  }

  .donations-faq-height-cal-{{ section.id }} {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    top: 0;
    left: 0;
    width: calc(100% - {{ faq_item_padding_horizontal_mobile | times: 2 }}px);
    padding-top: {{ faq_answer_padding_top }}px;
  }

  .donations-faq-height-cal-{{ section.id }} * {
    margin: 0;
    font-size: {{ faq_answer_size_mobile }}px;
    color: {{ faq_answer_color }};
    text-transform: unset;
  }

  .donations-faq-height-cal-{{ section.id }} p:not(:first-child) {
    margin-top: 10px;
  }

  @media(min-width: 1024px) {
    .section-{{ section.id }} {
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
      margin-left: {{ margin_horizontal }}rem;
      margin-right: {{ margin_horizontal }}rem;
      border-radius: {{ section_radius }}px;
    }

    .section-{{ section.id }}-settings {
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-left: {{ padding_horizontal }}rem;
      padding-right: {{ padding_horizontal }}rem;
    }

    .donations-caption-{{ section.id }} {
      font-size: 20px;
    }

    .donations-heading-{{ section.id }} {
      font-size: 40px;
    }

    .donations-intro-{{ section.id }} {
      font-size: 16px;
      margin-top: 30px;
    }

    .donations-panels-{{ section.id }} {
      width: calc(100% + {{ padding_horizontal | times: 2 }}rem);
      margin-left: -{{ padding_horizontal }}rem;
      margin-right: -{{ padding_horizontal }}rem;
    }

    .donations-panel-{{ section.id }} {
      gap: {{ faq_items_gap }}px;
      padding-left: {{ padding_horizontal }}rem;
      padding-right: {{ padding_horizontal }}rem;
    }

    .donations-faq-item-{{ section.id }} {
      padding: {{ faq_item_padding_vertical }}px {{ faq_item_padding_horizontal }}px;
    }

    .donations-faq-question-{{ section.id }} {
      font-size: {{ faq_question_size }}px;
    }

    .donations-faq-answer-{{ section.id }} * {
      font-size: {{ faq_answer_size }}px;
    }

    .donations-faq-height-cal-{{ section.id }} {
      width: calc(100% - {{ faq_item_padding_horizontal | times: 2 }}px);
    }

    .donations-faq-height-cal-{{ section.id }} * {
      font-size: {{ faq_answer_size }}px;
    }
  }
{%- endstyle -%}

{% unless full_width %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: clamp(100px, var(--page-content-width, var(--page-width)), 100%);
    }
  </style>
{% endunless %}

{% if margin_horizontal_mobile > 0 %}
  <style>
    .section-{{ section.id }} {
      border-left: solid {{ border_color }} {{ border_thickness }}px;
      border-right: solid {{ border_color }} {{ border_thickness }}px;
    }

    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: 0px;
        border-right: 0px;
      }
    }
  </style>
{% endif %}

{% if margin_horizontal > 0 %}
  <style>
    @media(min-width: 1024px) {
      .section-{{ section.id }} {
        border-left: solid {{ border_color }} {{ border_thickness }}px;
        border-right: solid {{ border_color }} {{ border_thickness }}px;
      }
    }
  </style>
{% endif %}

<div class="section-{{ section.id }}" data-section-id="{{ section.id }}" style="background-color:{{ background_color }}; background-image: {{ background_gradient }};">
  <div class="section-{{ section.id }}-settings">
    {% if caption_block and caption_block.settings.caption != blank %}
      <p class="donations-caption-{{ section.id }}" {{ caption_block.shopify_attributes }}>{{ caption_block.settings.caption }}</p>
    {% endif %}

    {% if heading_block and heading_block.settings.heading != blank %}
      <h2 class="donations-heading-{{ section.id }}" {{ heading_block.shopify_attributes }}>{{ heading_block.settings.heading }}</h2>
    {% endif %}

    {% if text_block and text_block.settings.text != blank %}
      <div class="donations-intro-{{ section.id }}" {{ text_block.shopify_attributes }}>{{ text_block.settings.text }}</div>
    {% endif %}

    {% if feature_blocks.size > 0 %}
      <div class="donations-features-{{ section.id }}">
        {% for block in feature_blocks %}
          <div class="donations-feature-{{ section.id }}" {{ block.shopify_attributes }}>
            <div class="donations-feature-icon-{{ section.id }}">
