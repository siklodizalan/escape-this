            </div>
            {% if block.settings.text != blank %}
              <p class="donations-feature-text-{{ section.id }}">{{ block.settings.text }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if category_blocks.size > 0 %}
      <div class="donations-tabs-{{ section.id }}" role="tablist">
        {% for block in category_blocks %}
          <button
            type="button"
            class="donations-tab-{{ section.id }}{% if forloop.first %} is-active{% endif %}"
            data-donations-tab-{{ section.id }}
            data-target="donations-panel-{{ block.id }}-{{ section.id }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="donations-tab-index-{{ section.id }}">{{ forloop.index }}</span><span class="donations-tab-full-{{ section.id }}">{{ block.settings.tab_label }}</span>
          </button>
        {% endfor %}
      </div>

      <div class="donations-panels-{{ section.id }}">
        {% assign inside_panel = false %}
        {% assign panel_index = -1 %}
        {% for block in section.blocks %}
          {% if block.type == 'category' %}
            {% if inside_panel %}
              </div>
            {% endif %}
            {% assign panel_index = panel_index | plus: 1 %}
            <div
              class="donations-panel-{{ section.id }}{% if panel_index == 0 %} is-active{% endif %}"
              id="donations-panel-{{ block.id }}-{{ section.id }}"
              role="tabpanel"
            >
              {% assign inside_panel = true %}
          {% elsif block.type == 'faq_item' %}
            <div class="donations-faq-item-{{ section.id }}">
              <div class="donations-faq-toggle-{{ section.id }}">
                <p class="donations-faq-question-{{ section.id }}">{{ block.settings.question }}</p>
                <div class="donations-faq-icon-{{ section.id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M8.00045 8.78094L11.3003 5.48112L12.2431 6.42393L8.00045 10.6666L3.75781 6.42393L4.70063 5.48112L8.00045 8.78094Z" fill="currentColor"></path>
                  </svg>
                </div>
              </div>
              <div class="donations-faq-answer-{{ section.id }}" style="display: none; height: 0px; padding-top: 0px; padding-bottom: 0px;">
                {{ block.settings.answer }}
              </div>
              <div class="donations-faq-height-cal-{{ section.id }}">
                {{ block.settings.answer }}
              </div>
            </div>
          {% endif %}
        {% endfor %}
        {% if inside_panel %}
          </div>
        {% endif %}
      </div>
    {% elsif faq_item_blocks.size > 0 %}
      <div class="donations-panels-{{ section.id }}">
        <div class="donations-panel-{{ section.id }} is-active">
          {% for block in faq_item_blocks %}
            <div class="donations-faq-item-{{ section.id }}" {{ block.shopify_attributes }}>
              <div class="donations-faq-toggle-{{ section.id }}">
                <p class="donations-faq-question-{{ section.id }}">{{ block.settings.question }}</p>
                <div class="donations-faq-icon-{{ section.id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M8.00045 8.78094L11.3003 5.48112L12.2431 6.42393L8.00045 10.6666L3.75781 6.42393L4.70063 5.48112L8.00045 8.78094Z" fill="currentColor"></path>
                  </svg>
                </div>
              </div>
              <div class="donations-faq-answer-{{ section.id }}" style="display: none; height: 0px; padding-top: 0px; padding-bottom: 0px;">
                {{ block.settings.answer }}
              </div>
              <div class="donations-faq-height-cal-{{ section.id }}">
                {{ block.settings.answer }}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
  function initDonationsTabs{{ section.id | replace: '-', '_' }}() {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]') || document;
    var tabs = section.querySelectorAll('[data-donations-tab-{{ section.id }}]');

    tabs.forEach(function (tab) {
      if (tab.dataset.donationsBound) return;
      tab.dataset.donationsBound = 'true';

      tab.addEventListener('click', function () {
        var targetId = tab.getAttribute('data-target');

        tabs.forEach(function (otherTab) {
          otherTab.classList.remove('is-active');
          otherTab.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        section.querySelectorAll('.donations-panel-{{ section.id }}').forEach(function (panel) {
          panel.classList.toggle('is-active', panel.id === targetId);
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initDonationsTabs{{ section.id | replace: '-', '_' }});
  document.addEventListener('shopify:section:load', initDonationsTabs{{ section.id | replace: '-', '_' }});

  function initDonationsFaq{{ section.id | replace: '-', '_' }}() {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]') || document;
    var items = section.querySelectorAll('.donations-faq-item-{{ section.id }}');
    var toggles = section.querySelectorAll('.donations-faq-toggle-{{ section.id }}');
    var answers = section.querySelectorAll('.donations-faq-answer-{{ section.id }}');
    var heightCalElements = section.querySelectorAll('.donations-faq-height-cal-{{ section.id }}');
    var icons = section.querySelectorAll('.donations-faq-icon-{{ section.id }}');

    var answerPaddingTop = {{ faq_answer_padding_top }};
    var answerPaddingBottom = 0;
    var activeIndex = -1;

    function openAnswer(index) {
      var height = heightCalElements[index].offsetHeight;

      answers[index].style.display = 'block';
      setTimeout(function () {
        answers[index].style.paddingTop = answerPaddingTop + 'px';
        answers[index].style.paddingBottom = answerPaddingBottom + 'px';
        answers[index].style.height = height + 'px';
      });

      items[index].classList.add('is-active');
      icons[index].classList.add('is-active');
    }

    function closeAnswer(index) {
      answers[index].style.paddingTop = 0;
      answers[index].style.paddingBottom = 0;
      answers[index].style.height = 0;

      setTimeout(function () {
        answers[index].style.display = 'none';
      }, 300);

      items[index].classList.remove('is-active');
      icons[index].classList.remove('is-active');
    }

    function toggleAnswer(index) {
      if (answers[index].style.display === 'none') {
        openAnswer(index);
        activeIndex = index;
      } else {
        closeAnswer(index);
        activeIndex = -1;
      }
    }

    function closeAllAnswersBut(index) {
      answers.forEach(function (answer, i) {
        if (i !== index) closeAnswer(i);
      });
    }

    toggles.forEach(function (toggle, index) {
      if (toggle.dataset.donationsFaqBound) return;
      toggle.dataset.donationsFaqBound = 'true';

      toggle.addEventListener('click', function () {
        toggleAnswer(index);
        closeAllAnswersBut(index);
      });
    });

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        if (activeIndex !== -1) {
          var height = heightCalElements[activeIndex].offsetHeight;
          answers[activeIndex].style.height = height + 'px';
        }
      }, 250);
    });
  }

  document.addEventListener('DOMContentLoaded', initDonationsFaq{{ section.id | replace: '-', '_' }});
  document.addEventListener('shopify:section:load', initDonationsFaq{{ section.id | replace: '-', '_' }});
</script>

